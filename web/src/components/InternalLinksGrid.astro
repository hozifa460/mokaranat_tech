---
interface Props {
  currentSlug: string;
  category: string;
  item_a_id?: string;
  item_b_id?: string;
  allComparisons: any[];
}

const { currentSlug, category, item_a_id, item_b_id, allComparisons } = Astro.props;

// Prioritize comparisons from the same category to spread internal PageRank within category hubs
const sameCategory = allComparisons.filter(c => c.slug !== currentSlug && c.category === category);

if (item_a_id || item_b_id) {
  sameCategory.sort((x, y) => {
    const xShares = (x.item_a_id === item_a_id || x.item_a_id === item_b_id || x.item_b_id === item_a_id || x.item_b_id === item_b_id) ? 1 : 0;
    const yShares = (y.item_a_id === item_a_id || y.item_a_id === item_b_id || y.item_b_id === item_a_id || y.item_b_id === item_b_id) ? 1 : 0;
    return yShares - xShares;
  });
}

const otherCategory = allComparisons.filter(c => c.slug !== currentSlug && c.category !== category);
const related = [...sameCategory, ...otherCategory].slice(0, 6);

const formatVal = (v: any) => {
  if (typeof v === 'number') {
    return Number.isInteger(v) ? v.toString() : v.toFixed(1).replace(/\.0$/, '');
  }
  if (typeof v === 'string' && /^-?\d+(\.\d+)?$/.test(v.trim())) {
    const num = parseFloat(v);
    return Number.isInteger(num) ? num.toString() : num.toFixed(1).replace(/\.0$/, '');
  }
  return v;
};
---

{related.length > 0 && (
  <section class="my-14 border-t border-slate-200 dark:border-slate-800 pt-10">
    <div class="mb-6">
      <h3 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
        <span>🔗</span>
        <span>مقارنات أخرى قد تهمك (Related Hardware Comparisons)</span>
      </h3>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
        استكشف مقارنات إضافية في نفس الفئة لاتخاذ قرار شراء متكامل.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {related.map(item => (
        <a
          href={`/compare/${item.slug}`}
          class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-blue-500 dark:hover:border-blue-500 transition-all hover:shadow-md group flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between text-[11px] font-bold text-slate-400 mb-2">
              <span class="uppercase text-blue-600 dark:text-blue-400">{item.category}</span>
              <span>{item.winner_name && item.winner_name.includes('تعادل') ? `🤝 ${item.winner_name}` : `⭐ الفائز: ${item.winner_name}`}</span>
            </div>
            <h4 class="font-bold text-sm text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 leading-snug">
              {item.title_ar}
            </h4>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs font-semibold text-slate-500">
            <span><bdi dir="ltr">{formatVal(item.score_a)} vs {formatVal(item.score_b)}</bdi></span>
            <span class="text-blue-600 dark:text-blue-400 group-hover:translate-x-[-3px] transition-transform">
              عرض المقارنة ←
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>
)}
