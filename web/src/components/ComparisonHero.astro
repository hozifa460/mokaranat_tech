---
interface Props {
  itemA: any;
  itemB: any;
  verdict: any;
  category: string;
}

const { itemA, itemB, verdict, category } = Astro.props;

const winnerA = verdict.overall_winner === 'a';
const winnerB = verdict.overall_winner === 'b';
const isTie = verdict.overall_winner === 'tie';

const winnerBadgeText = category === 'gpu' ? '🏆 الأسرع في الأداء الرسومي' : '🏆 الأعلى أداءً في البنشمارك';

// Competitor advantage badge: recognizes where the competitor leads (e.g. TDP, efficiency, pricing)
const getCompetitorBadge = (self: any, opponent: any) => {
  if (self?.launch_msrp_usd && opponent?.launch_msrp_usd && self.launch_msrp_usd < opponent.launch_msrp_usd) {
    return '💰 الأوفر في سعر الإطلاق';
  }
  if (self?.tdp_w && opponent?.tdp_w && self.tdp_w < opponent.tdp_w) {
    return '🌱 الأقل استهلاكاً للطاقة';
  }
  if (self?.efficiency_score && opponent?.efficiency_score && self.efficiency_score > opponent.efficiency_score) {
    return '⚡ الأعلى كفاءة لكل واط';
  }
  return null;
};

const competitorBadgeA = winnerB ? getCompetitorBadge(itemA, itemB) : null;
const competitorBadgeB = winnerA ? getCompetitorBadge(itemB, itemA) : null;

const formatVal = (v: any) => {
  if (typeof v === 'number') {
    return Number.isInteger(v) ? v.toString() : v.toFixed(1).replace(/\.0$/, '');
  }
  if (typeof v === 'string' && /^-?\d+(\.\d+)?$/.test(v.trim())) {
    const num = parseFloat(v);
    return Number.isInteger(num) ? num.toString() : num.toFixed(1).replace(/\.0$/, '');
  }
  return v;
};
---

<section class="relative overflow-hidden pt-8 pb-12 bg-gradient-to-b from-blue-50/50 via-white to-slate-50 dark:from-slate-900 dark:via-slate-950 dark:to-slate-950 border-b border-slate-200 dark:border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Category Badge & Breadcrumbs -->
    <div class="flex items-center gap-2 text-xs font-semibold text-blue-600 dark:text-blue-400 mb-4">
      <a href="/" class="hover:underline">الرئيسية</a>
      <span>/</span>
      <a href={`/category/${category}`} class="hover:underline uppercase">{category}</a>
      <span>/</span>
      <span class="text-slate-500 dark:text-slate-400">مقارنة شاملة</span>
    </div>

    <!-- Main Comparison Header -->
    <div class="text-center max-w-4xl mx-auto mb-10">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight mb-4">
        مقارنة <span class="text-blue-600 dark:text-blue-400">{itemA.name}</span> ضد <span class="text-indigo-600 dark:text-indigo-400">{itemB.name}</span>
      </h1>
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        مقارنة معمارية وتحليلات الأداء المتوقعة، مؤشرات كفاءة الطاقة، واختيار الأنسب لميزانيتك.
      </p>
    </div>

    <!-- Dual Hardware Comparison Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 relative max-w-5xl mx-auto">
      
      <!-- VS Badge in the center (desktop) -->
      <div class="hidden md:flex absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 z-20 w-14 h-14 rounded-full bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-black text-lg items-center justify-center shadow-xl border-4 border-slate-50 dark:border-slate-950">
        VS
      </div>

      <!-- Item A Card -->
      <div class={`rounded-2xl p-6 sm:p-8 bg-white dark:bg-slate-900 border-2 transition-all ${winnerA ? 'border-emerald-500 shadow-xl shadow-emerald-500/10' : (competitorBadgeA ? 'border-amber-200 dark:border-amber-900/40 shadow-sm' : 'border-slate-200 dark:border-slate-800 shadow-sm')}`}>
        <div class="flex items-center justify-between gap-4 mb-4">
          <span class="px-3 py-1 rounded-full text-xs font-bold bg-blue-100 dark:bg-blue-950 text-blue-700 dark:text-blue-300">
            {itemA.brand}
          </span>
          {winnerA && (
            <span class="px-3 py-1 rounded-full text-xs font-extrabold bg-emerald-500 text-white flex items-center gap-1 shadow-sm">
              {winnerBadgeText}
            </span>
          )}
          {competitorBadgeA && (
            <span class="px-3 py-1 rounded-full text-xs font-bold bg-amber-100 dark:bg-amber-950/80 text-amber-700 dark:text-amber-300 flex items-center gap-1 shadow-sm">
              {competitorBadgeA}
            </span>
          )}
          {isTie && (
            <span class="px-3 py-1 rounded-full text-xs font-bold bg-blue-100 dark:bg-blue-950/80 text-blue-700 dark:text-blue-300 flex items-center gap-1 shadow-sm">
              🤝 تعادل متقارب في الأداء
            </span>
          )}
        </div>

        <h2 class="text-2xl font-black text-slate-900 dark:text-white mb-2">
          {itemA.name}
        </h2>

        <div class="flex items-baseline gap-2 mb-6">
          <span class="text-3xl font-extrabold text-slate-900 dark:text-white">
            <bdi dir="ltr">${formatVal(itemA.launch_msrp_usd)}</bdi>
          </span>
          <span class="text-xs text-slate-500">سعر الإطلاق الرسمي</span>
        </div>

        <!-- Performance Index Meter -->
        <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/60 mb-6">
          <div class="flex items-center justify-between mb-2 text-sm font-bold">
            <span class="text-slate-600 dark:text-slate-300">مؤشر الأداء المعياري</span>
            <bdi dir="ltr" class="text-blue-600 dark:text-blue-400 text-lg font-black whitespace-nowrap">{formatVal(itemA.benchmark_index)} / 100</bdi>
          </div>
          <div class="w-full bg-slate-200 dark:bg-slate-700 h-3 rounded-full overflow-hidden">
            <div class="bg-blue-600 h-full rounded-full transition-all" style={`width: ${Math.min(100, Math.max(10, Math.round(Number(itemA.benchmark_index) || 0)))}%`}></div>
          </div>
        </div>

        <!-- Quick Specs Pills -->
        <div class="flex flex-wrap gap-2 text-xs">
          <span class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium">
            ⚡ <bdi dir="ltr">{itemA.tdp_w}W</bdi> استهلاك
          </span>
          <span class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium">
            🔬 <bdi dir="ltr">{formatVal(itemA.process_node_nm)}nm</bdi> معمارية {itemA.architecture}
          </span>
          {itemA.raw_specs?.vram_gb && (
            <span class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium">
              💾 <bdi dir="ltr">{itemA.raw_specs.vram_gb}GB</bdi> VRAM
            </span>
          )}
          {itemA.raw_specs?.total_cores && (
            <span class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium">
              🧠 <bdi dir="ltr">{itemA.raw_specs.total_cores}</bdi> أنوية
            </span>
          )}
          {itemA.raw_specs?.weight_kg && (
            <span class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium">
              ⚖️ <bdi dir="ltr">{itemA.raw_specs.weight_kg}</bdi> كجم
            </span>
          )}
          {itemA.raw_specs?.battery_wh && (
            <span class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium">
              🔋 <bdi dir="ltr">{itemA.raw_specs.battery_wh}Wh</bdi> بطارية
            </span>
          )}
          {itemA.raw_specs?.display && (
            <span class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium truncate max-w-[200px]" title={itemA.raw_specs.display}>
              🖥️ {itemA.raw_specs.display}
            </span>
          )}
        </div>
      </div>

      <!-- Item B Card -->
      <div class={`rounded-2xl p-6 sm:p-8 bg-white dark:bg-slate-900 border-2 transition-all ${winnerB ? 'border-emerald-500 shadow-xl shadow-emerald-500/10' : (competitorBadgeB ? 'border-amber-200 dark:border-amber-900/40 shadow-sm' : 'border-slate-200 dark:border-slate-800 shadow-sm')}`}>
        <div class="flex items-center justify-between gap-4 mb-4">
          <span class="px-3 py-1 rounded-full text-xs font-bold bg-indigo-100 dark:bg-indigo-950 text-indigo-700 dark:text-indigo-300">
            {itemB.brand}
          </span>
          {winnerB && (
            <span class="px-3 py-1 rounded-full text-xs font-extrabold bg-emerald-500 text-white flex items-center gap-1 shadow-sm">
              {winnerBadgeText}
            </span>
          )}
          {competitorBadgeB && (
            <span class="px-3 py-1 rounded-full text-xs font-bold bg-amber-100 dark:bg-amber-950/80 text-amber-700 dark:text-amber-300 flex items-center gap-1 shadow-sm">
              {competitorBadgeB}
            </span>
          )}
          {isTie && (
            <span class="px-3 py-1 rounded-full text-xs font-bold bg-indigo-100 dark:bg-indigo-950/80 text-indigo-700 dark:text-indigo-300 flex items-center gap-1 shadow-sm">
              🤝 تعادل متقارب في الأداء
            </span>
          )}
        </div>

        <h2 class="text-2xl font-black text-slate-900 dark:text-white mb-2">
          {itemB.name}
        </h2>

        <div class="flex items-baseline gap-2 mb-6">
          <span class="text-3xl font-extrabold text-slate-900 dark:text-white">
            <bdi dir="ltr">${formatVal(itemB.launch_msrp_usd)}</bdi>
          </span>
          <span class="text-xs text-slate-500">سعر الإطلاق الرسمي</span>
        </div>

        <!-- Performance Index Meter -->
        <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/60 mb-6">
          <div class="flex items-center justify-between mb-2 text-sm font-bold">
            <span class="text-slate-600 dark:text-slate-300">مؤشر الأداء المعياري</span>
            <bdi dir="ltr" class="text-indigo-600 dark:text-indigo-400 text-lg font-black whitespace-nowrap">{formatVal(itemB.benchmark_index)} / 100</bdi>
          </div>
          <div class="w-full bg-slate-200 dark:bg-slate-700 h-3 rounded-full overflow-hidden">
            <div class="bg-indigo-600 h-full rounded-full transition-all" style={`width: ${Math.min(100, Math.max(10, Math.round(Number(itemB.benchmark_index) || 0)))}%`}></div>
          </div>
        </div>

        <!-- Quick Specs Pills -->
        <div class="flex flex-wrap gap-2 text-xs">
          <span class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium">
            ⚡ <bdi dir="ltr">{itemB.tdp_w}W</bdi> استهلاك
          </span>
          <span class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium">
            🔬 <bdi dir="ltr">{formatVal(itemB.process_node_nm)}nm</bdi> معمارية {itemB.architecture}
          </span>
          {itemB.raw_specs?.vram_gb && (
            <span class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium">
              💾 <bdi dir="ltr">{itemB.raw_specs.vram_gb}GB</bdi> VRAM
            </span>
          )}
          {itemB.raw_specs?.total_cores && (
            <span class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium">
              🧠 <bdi dir="ltr">{itemB.raw_specs.total_cores}</bdi> أنوية
            </span>
          )}
          {itemB.raw_specs?.weight_kg && (
            <span class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium">
              ⚖️ <bdi dir="ltr">{itemB.raw_specs.weight_kg}</bdi> كجم
            </span>
          )}
          {itemB.raw_specs?.battery_wh && (
            <span class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium">
              🔋 <bdi dir="ltr">{itemB.raw_specs.battery_wh}Wh</bdi> بطارية
            </span>
          )}
          {itemB.raw_specs?.display && (
            <span class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium truncate max-w-[200px]" title={itemB.raw_specs.display}>
              🖥️ {itemB.raw_specs.display}
            </span>
          )}
        </div>
      </div>

    </div>

    <!-- Quick Editorial Verdict Box -->
    <div class="mt-8 max-w-5xl mx-auto rounded-2xl p-5 sm:p-6 bg-gradient-to-r from-blue-500/10 via-indigo-500/10 to-transparent border border-blue-200 dark:border-blue-900/50 flex flex-col sm:flex-row items-start sm:items-center gap-4">
      <div class="w-12 h-12 rounded-xl bg-blue-600 text-white flex-shrink-0 flex items-center justify-center font-bold text-xl">
        💡
      </div>
      <div>
        <h4 class="font-bold text-slate-900 dark:text-white text-sm mb-1">
          خلاصة الحكم السريع (Quick Verdict)
        </h4>
        <p class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
          {verdict.quick_verdict_ar}
        </p>
      </div>
    </div>

  </div>
</section>
