---
/**
 * ComparisonBuilder.astro
 * Phase 20: Interactive Hardware Comparison Selector & Bidirectional Router
 * Features category tabs, independent dual quick-search inputs, brand filters,
 * mutual de-duplication, clean item swapping, and bidirectional slug resolution.
 */
import comparisonsIndex from '../data/comparisons_index.json';

interface Props {
  initialCategory?: 'gpu' | 'cpu' | 'laptop' | string;
  initialItemA?: string;
  initialItemB?: string;
  title?: string;
  subtitle?: string;
  compact?: boolean;
}

const {
  initialCategory = 'gpu',
  initialItemA = '',
  initialItemB = '',
  title = 'أداة المقارنة التفاعلية الذكية',
  subtitle = 'اختر أي قطعتين من نفس الفئة واحصل فوراً على مقارنة رقمية تفصيلية ومعدلات الإطارات والحكم النهائي.',
  compact = false
} = Astro.props;

// Build unique hardware catalog from index manifest
interface ItemMeta {
  id: string;
  name: string;
  brand: string;
  category: string;
}

const itemsMap = new Map<string, ItemMeta>();
const pairMap: Record<string, string> = {};

comparisonsIndex.forEach((c: any) => {
  if (c.item_a_id && !itemsMap.has(c.item_a_id)) {
    itemsMap.set(c.item_a_id, {
      id: c.item_a_id,
      name: c.item_a_name,
      brand: c.item_a_brand || '',
      category: c.category
    });
  }
  if (c.item_b_id && !itemsMap.has(c.item_b_id)) {
    itemsMap.set(c.item_b_id, {
      id: c.item_b_id,
      name: c.item_b_name,
      brand: c.item_b_brand || '',
      category: c.category
    });
  }

  // Bidirectional pair mapping
  pairMap[`${c.item_a_id}:${c.item_b_id}`] = c.slug;
  pairMap[`${c.item_b_id}:${c.item_a_id}`] = c.slug;
});

// Group catalog by category and brand
const catalogByCategory: Record<string, Record<string, ItemMeta[]>> = {
  gpu: {},
  cpu: {},
  laptop: {}
};

itemsMap.forEach(item => {
  const cat = item.category || 'gpu';
  if (!catalogByCategory[cat]) {
    catalogByCategory[cat] = {};
  }
  const brand = item.brand || 'أخرى';
  if (!catalogByCategory[cat][brand]) {
    catalogByCategory[cat][brand] = [];
  }
  catalogByCategory[cat][brand].push(item);
});

// Sort items within each brand by name
Object.keys(catalogByCategory).forEach(cat => {
  Object.keys(catalogByCategory[cat]).forEach(brand => {
    catalogByCategory[cat][brand].sort((a, b) => a.name.localeCompare(b.name, 'ar'));
  });
});

const instanceId = `cb-${Math.random().toString(36).substring(2, 9)}`;

const categories = [
  { id: 'gpu', label: 'كروت الشاشة', icon: '🎮', english: 'GPUs' },
  { id: 'cpu', label: 'المعالجات', icon: '⚙️', english: 'CPUs' },
  { id: 'laptop', label: 'اللابتوبات', icon: '💻', english: 'Laptops' }
];

const initialBrands = Object.keys(catalogByCategory[initialCategory] || {});
---

<div
  id={instanceId}
  class={`comparison-builder rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/95 shadow-xl overflow-hidden backdrop-blur-sm transition-all ${compact ? 'p-5 sm:p-6' : 'p-6 sm:p-8 my-8'}`}
  data-catalog={JSON.stringify(catalogByCategory)}
  data-pair-map={JSON.stringify(pairMap)}
  data-active-cat={initialCategory}
  data-initial-a={initialItemA}
  data-initial-b={initialItemB}
  dir="rtl"
>
  <!-- Header -->
  <div class="text-center max-w-2xl mx-auto mb-6">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-950/80 text-blue-600 dark:text-blue-400 text-xs font-bold mb-2">
      <span>⚡</span>
      <span>مقارنة فورية مخصصة</span>
    </div>
    <h2 class={`${compact ? 'text-xl sm:text-2xl' : 'text-2xl sm:text-3xl'} font-black text-slate-900 dark:text-white tracking-tight`}>
      {title}
    </h2>
    {subtitle && (
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1.5 leading-relaxed">
        {subtitle}
      </p>
    )}
  </div>

  <!-- Category Tabs -->
  <div class="flex items-center justify-center gap-2 mb-6 p-1.5 rounded-2xl bg-slate-100 dark:bg-slate-800/80 max-w-md mx-auto">
    {categories.map(cat => (
      <button
        type="button"
        data-cat-btn={cat.id}
        class={`builder-tab-btn flex-1 py-2 px-3 rounded-xl text-xs sm:text-sm font-bold transition-all flex items-center justify-center gap-1.5 ${cat.id === initialCategory ? 'bg-white dark:bg-slate-900 text-blue-600 dark:text-blue-400 shadow-sm' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'}`}
      >
        <span>{cat.icon}</span>
        <span>{cat.label}</span>
      </button>
    ))}
  </div>

  <!-- Selectors Grid (Item 1 vs Item 2) -->
  <div class="grid grid-cols-1 lg:grid-cols-11 gap-5 items-start max-w-4xl mx-auto">
    
    <!-- Item 1 Card -->
    <div class="lg:col-span-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-4 transition-all focus-within:border-blue-500/80 focus-within:bg-white dark:focus-within:bg-slate-800/80">
      <div class="flex items-center justify-between mb-3">
        <label class="text-xs font-extrabold text-slate-800 dark:text-slate-200 flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-blue-500 inline-block shadow-sm shadow-blue-500/50"></span>
          <span>الطرف الأول (القطعة الأولى):</span>
        </label>
        <span class="text-[11px] font-bold px-2 py-0.5 rounded-md bg-blue-100/70 dark:bg-blue-950/80 text-blue-700 dark:text-blue-300 brand-tag-a hidden"></span>
      </div>

      <!-- Quick Search Input for Item 1 -->
      <div class="relative mb-2.5">
        <input
          type="text"
          class="quick-search-a w-full py-2 pr-8 pl-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-xs placeholder-slate-400 focus:outline-none focus:border-blue-500 shadow-sm transition-colors"
          placeholder="🔍 تصفية سريعة بالاسم (مثلاً: 4070 أو Ryzen)..."
        />
        <span class="absolute right-2.5 top-1/2 -translate-y-1/2 text-xs text-slate-400 pointer-events-none">
          ⚡
        </span>
      </div>

      <!-- Brand Filter Pills for Item 1 -->
      <div class="brand-pills-a flex items-center gap-1 mb-3 flex-wrap">
        <button
          type="button"
          data-brand="all"
          class="brand-pill-btn-a active px-2.5 py-0.5 rounded-lg text-[11px] font-bold border border-blue-500 bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-300 transition-colors"
        >
          الكل
        </button>
        {initialBrands.map(b => (
          <button
            type="button"
            data-brand={b}
            class="brand-pill-btn-a px-2.5 py-0.5 rounded-lg text-[11px] font-bold border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors"
          >
            {b}
          </button>
        ))}
      </div>

      <!-- Item 1 Select Dropdown -->
      <div class="relative">
        <select
          class="selector-item-a w-full py-3 pr-3.5 pl-9 rounded-xl border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white font-bold text-xs sm:text-sm focus:outline-none focus:border-blue-500 transition-colors cursor-pointer appearance-none shadow-sm"
        >
          <option value="" disabled selected>اختر القطعة الأولى...</option>
        </select>
        <span class="absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-xs">
          ▼
        </span>
      </div>
    </div>

    <!-- Swap / VS Badge -->
    <div class="lg:col-span-1 flex items-center justify-center pt-2 lg:pt-14">
      <button
        type="button"
        class="swap-btn w-12 h-12 rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-100 dark:bg-slate-800 hover:bg-blue-50 hover:border-blue-500 dark:hover:bg-blue-950/50 text-slate-700 dark:text-slate-300 hover:text-blue-600 transition-all flex items-center justify-center font-black text-base shadow-sm group"
        title="تبديل موقع القطعتين"
      >
        <span class="group-hover:rotate-180 transition-transform duration-300">⇄</span>
      </button>
    </div>

    <!-- Item 2 Card -->
    <div class="lg:col-span-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-4 transition-all focus-within:border-indigo-500/80 focus-within:bg-white dark:focus-within:bg-slate-800/80">
      <div class="flex items-center justify-between mb-3">
        <label class="text-xs font-extrabold text-slate-800 dark:text-slate-200 flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-indigo-500 inline-block shadow-sm shadow-indigo-500/50"></span>
          <span>الطرف الثاني (القطعة المنافسة):</span>
        </label>
        <span class="text-[11px] font-bold px-2 py-0.5 rounded-md bg-indigo-100/70 dark:bg-indigo-950/80 text-indigo-700 dark:text-indigo-300 brand-tag-b hidden"></span>
      </div>

      <!-- Quick Search Input for Item 2 -->
      <div class="relative mb-2.5">
        <input
          type="text"
          class="quick-search-b w-full py-2 pr-8 pl-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-xs placeholder-slate-400 focus:outline-none focus:border-indigo-500 shadow-sm transition-colors"
          placeholder="🔍 تصفية سريعة بالاسم (مثلاً: 7800 أو Core)..."
        />
        <span class="absolute right-2.5 top-1/2 -translate-y-1/2 text-xs text-slate-400 pointer-events-none">
          ⚡
        </span>
      </div>

      <!-- Brand Filter Pills for Item 2 -->
      <div class="brand-pills-b flex items-center gap-1 mb-3 flex-wrap">
        <button
          type="button"
          data-brand="all"
          class="brand-pill-btn-b active px-2.5 py-0.5 rounded-lg text-[11px] font-bold border border-indigo-500 bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-300 transition-colors"
        >
          الكل
        </button>
        {initialBrands.map(b => (
          <button
            type="button"
            data-brand={b}
            class="brand-pill-btn-b px-2.5 py-0.5 rounded-lg text-[11px] font-bold border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors"
          >
            {b}
          </button>
        ))}
      </div>

      <!-- Item 2 Select Dropdown -->
      <div class="relative">
        <select
          class="selector-item-b w-full py-3 pr-3.5 pl-9 rounded-xl border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white font-bold text-xs sm:text-sm focus:outline-none focus:border-indigo-500 transition-colors cursor-pointer appearance-none shadow-sm"
        >
          <option value="" disabled selected>اختر القطعة الثانية...</option>
        </select>
        <span class="absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-xs">
          ▼
        </span>
      </div>
    </div>

  </div>

  <!-- Action Bar & Validation Feedback -->
  <div class="mt-6 pt-5 border-t border-slate-100 dark:border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 max-w-4xl mx-auto">
    <div class="feedback-msg text-xs font-semibold text-slate-500 dark:text-slate-400 flex items-center gap-1.5">
      <span class="status-icon text-sm">💡</span>
      <span class="status-text">اختر قطعتين مختلفتين للبدء في المقارنة التفصيلية.</span>
    </div>

    <button
      type="button"
      class="compare-now-btn w-full sm:w-auto px-8 py-3.5 rounded-2xl bg-gradient-to-l from-blue-600 via-indigo-600 to-blue-700 hover:from-blue-700 hover:to-indigo-700 text-white font-black text-sm shadow-lg shadow-blue-500/25 hover:shadow-blue-500/40 hover:scale-[1.02] active:scale-[0.98] transition-all disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:scale-100 flex items-center justify-center gap-2 cursor-pointer"
      disabled
    >
      <span>قارن الآن بالأرقام</span>
      <span>⚡</span>
    </button>
  </div>
</div>

<script is:inline define:vars={{ instanceId }}>
  (function () {
    const root = document.getElementById(instanceId);
    if (!root) return;

    const catalog = JSON.parse(root.getAttribute('data-catalog') || '{}');
    const pairMap = JSON.parse(root.getAttribute('data-pair-map') || '{}');
    let currentCategory = root.getAttribute('data-active-cat') || 'gpu';
    let initialA = root.getAttribute('data-initial-a') || '';
    let initialB = root.getAttribute('data-initial-b') || '';

    const tabBtns = root.querySelectorAll('.builder-tab-btn');
    const selectA = root.querySelector('.selector-item-a');
    const selectB = root.querySelector('.selector-item-b');
    const searchA = root.querySelector('.quick-search-a');
    const searchB = root.querySelector('.quick-search-b');
    const brandPillsA = root.querySelector('.brand-pills-a');
    const brandPillsB = root.querySelector('.brand-pills-b');
    const swapBtn = root.querySelector('.swap-btn');
    const compareBtn = root.querySelector('.compare-now-btn');
    const feedbackIcon = root.querySelector('.status-icon');
    const feedbackText = root.querySelector('.status-text');
    const brandTagA = root.querySelector('.brand-tag-a');
    const brandTagB = root.querySelector('.brand-tag-b');

    let brandFilterA = 'all';
    let brandFilterB = 'all';
    let queryA = '';
    let queryB = '';

    function getItemById(id) {
      if (!id) return null;
      const catData = catalog[currentCategory] || {};
      for (const brand of Object.keys(catData)) {
        const found = catData[brand].find(i => i.id === id);
        if (found) return found;
      }
      return null;
    }

    function renderBrandPillsForSide(side, container, currentFilter, colorTheme) {
      if (!container) return;
      container.innerHTML = '';
      const catData = catalog[currentCategory] || {};
      const brands = Object.keys(catData);

      const allBtn = document.createElement('button');
      allBtn.type = 'button';
      allBtn.setAttribute('data-brand', 'all');
      allBtn.className = `brand-pill-btn-${side} px-2.5 py-0.5 rounded-lg text-[11px] font-bold border transition-colors ${currentFilter === 'all' ? (colorTheme === 'blue' ? 'border-blue-500 bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-300' : 'border-indigo-500 bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-300') : 'border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'}`;
      allBtn.textContent = 'الكل';
      allBtn.addEventListener('click', () => {
        if (side === 'a') {
          brandFilterA = 'all';
        } else {
          brandFilterB = 'all';
        }
        renderBrandPills();
        rebuildSelect(side);
        updateValidation();
      });
      container.appendChild(allBtn);

      brands.forEach(brand => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.setAttribute('data-brand', brand);
        const isActive = currentFilter.toLowerCase() === brand.toLowerCase();
        btn.className = `brand-pill-btn-${side} px-2.5 py-0.5 rounded-lg text-[11px] font-bold border transition-colors ${isActive ? (colorTheme === 'blue' ? 'border-blue-500 bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-300' : 'border-indigo-500 bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-300') : 'border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'}`;
        btn.textContent = brand;
        btn.addEventListener('click', () => {
          if (side === 'a') {
            brandFilterA = brand;
          } else {
            brandFilterB = brand;
          }
          renderBrandPills();
          rebuildSelect(side);
          updateValidation();
        });
        container.appendChild(btn);
      });
    }

    function renderBrandPills() {
      renderBrandPillsForSide('a', brandPillsA, brandFilterA, 'blue');
      renderBrandPillsForSide('b', brandPillsB, brandFilterB, 'indigo');
    }

    function populateSelectElement(selectElement, brandFilter, searchFilter, otherSelectedValue, preferredSelectedValue) {
      const isSideA = selectElement === selectA;
      const placeholderText = isSideA ? 'اختر القطعة الأولى...' : 'اختر القطعة الثانية...';
      const catData = catalog[currentCategory] || {};
      const cleanSearch = (searchFilter || '').trim().toLowerCase();

      selectElement.innerHTML = '';
      const placeholder = document.createElement('option');
      placeholder.value = '';
      placeholder.disabled = true;
      placeholder.textContent = placeholderText;
      selectElement.appendChild(placeholder);

      let foundPreferred = false;

      Object.keys(catData).forEach(brand => {
        if (brandFilter !== 'all' && brand.toLowerCase() !== brandFilter.toLowerCase()) {
          return;
        }

        const matchingItems = catData[brand].filter(item => {
          if (!cleanSearch) return true;
          return item.name.toLowerCase().includes(cleanSearch) || item.brand.toLowerCase().includes(cleanSearch);
        });

        if (matchingItems.length === 0) return;

        const optgroup = document.createElement('optgroup');
        optgroup.label = `─── ${brand} ───`;

        matchingItems.forEach(item => {
          const opt = document.createElement('option');
          opt.value = item.id;
          opt.textContent = item.name;

          if (item.id === otherSelectedValue) {
            opt.disabled = true;
            opt.textContent += ' (مختارة بالفعل)';
          }

          if (item.id === preferredSelectedValue) {
            opt.selected = true;
            foundPreferred = true;
          }

          optgroup.appendChild(opt);
        });

        selectElement.appendChild(optgroup);
      });

      if (foundPreferred) {
        selectElement.value = preferredSelectedValue;
      } else {
        placeholder.selected = true;
        selectElement.value = '';
      }
    }

    function rebuildSelect(side) {
      if (side === 'a') {
        const currentA = selectA.value || initialA;
        const currentB = selectB.value || initialB;
        populateSelectElement(selectA, brandFilterA, queryA, currentB, currentA);
      } else {
        const currentA = selectA.value || initialA;
        const currentB = selectB.value || initialB;
        populateSelectElement(selectB, brandFilterB, queryB, currentA, currentB);
      }
    }

    function rebuildBoth(targetA, targetB) {
      populateSelectElement(selectA, brandFilterA, queryA, targetB, targetA);
      populateSelectElement(selectB, brandFilterB, queryB, targetA, targetB);
    }

    function updateValidation() {
      const idA = selectA.value;
      const idB = selectB.value;

      // Update brand tags
      if (idA) {
        const itemA = getItemById(idA);
        if (brandTagA && itemA) {
          brandTagA.textContent = itemA.brand;
          brandTagA.classList.remove('hidden');
        }
      } else {
        if (brandTagA) {
          brandTagA.textContent = '';
          brandTagA.classList.add('hidden');
        }
      }

      if (idB) {
        const itemB = getItemById(idB);
        if (brandTagB && itemB) {
          brandTagB.textContent = itemB.brand;
          brandTagB.classList.remove('hidden');
        }
      } else {
        if (brandTagB) {
          brandTagB.textContent = '';
          brandTagB.classList.add('hidden');
        }
      }

      if (!idA && !idB) {
        compareBtn.disabled = true;
        feedbackIcon.textContent = '💡';
        feedbackText.textContent = 'اختر قطعتين مختلفتين للبدء في المقارنة التفصيلية.';
        return;
      }

      if (!idA) {
        compareBtn.disabled = true;
        feedbackIcon.textContent = '💡';
        feedbackText.textContent = 'يرجى اختيار القطعة الأولى للمقارنة.';
        return;
      }

      if (!idB) {
        compareBtn.disabled = true;
        feedbackIcon.textContent = '💡';
        feedbackText.textContent = 'يرجى اختيار القطعة الثانية للمقارنة.';
        return;
      }

      if (idA === idB) {
        compareBtn.disabled = true;
        feedbackIcon.textContent = '⚠️';
        feedbackText.textContent = 'لا يمكنك مقارنة القطعة بنفسها، يرجى اختيار قطعتين مختلفتين.';
        return;
      }

      // Check bidirectional slug resolution
      const matchedSlug = pairMap[`${idA}:${idB}`] || pairMap[`${idB}:${idA}`];
      if (matchedSlug) {
        compareBtn.disabled = false;
        feedbackIcon.textContent = '✅';
        feedbackText.textContent = 'المقارنة جاهزة ومدعومة بالكامل! اضغط على زر المقارنة بالأرقام.';
      } else {
        compareBtn.disabled = true;
        feedbackIcon.textContent = '🔍';
        feedbackText.textContent = 'المقارنة المحددة قيد الإعداد قريباً.';
      }
    }

    // Category Tabs Switching
    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-cat-btn');
        if (cat === currentCategory) return;
        currentCategory = cat;

        tabBtns.forEach(b => {
          if (b === btn) {
            b.className = 'builder-tab-btn flex-1 py-2 px-3 rounded-xl text-xs sm:text-sm font-bold transition-all flex items-center justify-center gap-1.5 bg-white dark:bg-slate-900 text-blue-600 dark:text-blue-400 shadow-sm';
          } else {
            b.className = 'builder-tab-btn flex-1 py-2 px-3 rounded-xl text-xs sm:text-sm font-bold transition-all flex items-center justify-center gap-1.5 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white';
          }
        });

        brandFilterA = 'all';
        brandFilterB = 'all';
        queryA = '';
        queryB = '';
        if (searchA) searchA.value = '';
        if (searchB) searchB.value = '';

        initialA = '';
        initialB = '';

        renderBrandPills();
        rebuildBoth('', '');
        updateValidation();
      });
    });

    // Quick Search Inputs
    if (searchA) {
      searchA.addEventListener('input', (e) => {
        queryA = e.target.value;
        rebuildSelect('a');
        updateValidation();
      });
    }

    if (searchB) {
      searchB.addEventListener('input', (e) => {
        queryB = e.target.value;
        rebuildSelect('b');
        updateValidation();
      });
    }

    // Dropdown change events with symmetrical mutual de-duplication
    selectA.addEventListener('change', () => {
      const valA = selectA.value;
      const valB = selectB.value;
      // Rebuild selectB so newly chosen valA is disabled in selectB
      populateSelectElement(selectB, brandFilterB, queryB, valA, valB !== valA ? valB : '');
      updateValidation();
    });

    selectB.addEventListener('change', () => {
      const valA = selectA.value;
      const valB = selectB.value;
      // Rebuild selectA so newly chosen valB is disabled in selectA
      populateSelectElement(selectA, brandFilterA, queryA, valB, valA !== valB ? valA : '');
      updateValidation();
    });

    // Swap button
    if (swapBtn) {
      swapBtn.addEventListener('click', () => {
        const valA = selectA.value;
        const valB = selectB.value;
        if (!valA && !valB) return;

        // Reset search filters so swapped items are visible
        queryA = '';
        queryB = '';
        if (searchA) searchA.value = '';
        if (searchB) searchB.value = '';

        brandFilterA = 'all';
        brandFilterB = 'all';
        renderBrandPills();

        // Symmetrically swap targets
        rebuildBoth(valB, valA);
        updateValidation();
      });
    }

    // Compare Now button action with bidirectional slug resolution
    compareBtn.addEventListener('click', () => {
      const idA = selectA.value;
      const idB = selectB.value;
      if (!idA || !idB || idA === idB) return;

      const matchedSlug = pairMap[`${idA}:${idB}`] || pairMap[`${idB}:${idA}`];
      if (matchedSlug) {
        window.location.href = `/compare/${matchedSlug}`;
      }
    });

    // Initial setup
    renderBrandPills();
    rebuildBoth(initialA, initialB);
    initialA = '';
    initialB = '';
    updateValidation();
  })();
</script>
