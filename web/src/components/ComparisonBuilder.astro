---
/**
 * ComparisonBuilder.astro
 * Phase 20: Interactive Hardware Comparison Selector & Bidirectional Router
 * Allows users to choose category, brand, and two hardware items,
 * and seamlessly routes to the corresponding comparison page.
 */
import comparisonsIndex from '../data/comparisons_index.json';

interface Props {
  initialCategory?: 'gpu' | 'cpu' | 'laptop' | string;
  initialItemA?: string;
  initialItemB?: string;
  title?: string;
  subtitle?: string;
  compact?: boolean;
}

const {
  initialCategory = 'gpu',
  initialItemA = '',
  initialItemB = '',
  title = 'أداة المقارنة التفاعلية الذكية',
  subtitle = 'اختر أي قطعتين من نفس الفئة واحصل فوراً على مقارنة رقمية تفصيلية ومعدلات الإطارات والحكم النهائي.',
  compact = false
} = Astro.props;

// Build unique hardware catalog from index manifest
interface ItemMeta {
  id: string;
  name: string;
  brand: string;
  category: string;
}

const itemsMap = new Map<string, ItemMeta>();
const pairMap: Record<string, string> = {};

comparisonsIndex.forEach((c: any) => {
  if (c.item_a_id && !itemsMap.has(c.item_a_id)) {
    itemsMap.set(c.item_a_id, {
      id: c.item_a_id,
      name: c.item_a_name,
      brand: c.item_a_brand || '',
      category: c.category
    });
  }
  if (c.item_b_id && !itemsMap.has(c.item_b_id)) {
    itemsMap.set(c.item_b_id, {
      id: c.item_b_id,
      name: c.item_b_name,
      brand: c.item_b_brand || '',
      category: c.category
    });
  }

  // Bidirectional pair mapping
  pairMap[`${c.item_a_id}:${c.item_b_id}`] = c.slug;
  pairMap[`${c.item_b_id}:${c.item_a_id}`] = c.slug;
});

// Group catalog by category and brand
const catalogByCategory: Record<string, Record<string, ItemMeta[]>> = {
  gpu: {},
  cpu: {},
  laptop: {}
};

itemsMap.forEach(item => {
  const cat = item.category || 'gpu';
  if (!catalogByCategory[cat]) {
    catalogByCategory[cat] = {};
  }
  const brand = item.brand || 'أخرى';
  if (!catalogByCategory[cat][brand]) {
    catalogByCategory[cat][brand] = [];
  }
  catalogByCategory[cat][brand].push(item);
});

// Sort items within each brand by name
Object.keys(catalogByCategory).forEach(cat => {
  Object.keys(catalogByCategory[cat]).forEach(brand => {
    catalogByCategory[cat][brand].sort((a, b) => a.name.localeCompare(b.name, 'ar'));
  });
});

const instanceId = `cb-${Math.random().toString(36).substring(2, 9)}`;

const categories = [
  { id: 'gpu', label: 'كروت الشاشة', icon: '🎮', english: 'GPUs' },
  { id: 'cpu', label: 'المعالجات', icon: '⚙️', english: 'CPUs' },
  { id: 'laptop', label: 'اللابتوبات', icon: '💻', english: 'Laptops' }
];
---

<div
  id={instanceId}
  class={`comparison-builder rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/90 shadow-xl overflow-hidden backdrop-blur-sm transition-all ${compact ? 'p-5 sm:p-6' : 'p-6 sm:p-8 my-8'}`}
  data-catalog={JSON.stringify(catalogByCategory)}
  data-pair-map={JSON.stringify(pairMap)}
  data-active-cat={initialCategory}
  data-initial-a={initialItemA}
  data-initial-b={initialItemB}
  dir="rtl"
>
  <!-- Header -->
  <div class="text-center max-w-2xl mx-auto mb-6">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-950/80 text-blue-600 dark:text-blue-400 text-xs font-bold mb-2">
      <span>⚡</span>
      <span>مقارنة فورية مخصصة</span>
    </div>
    <h2 class={`${compact ? 'text-xl sm:text-2xl' : 'text-2xl sm:text-3xl'} font-black text-slate-900 dark:text-white tracking-tight`}>
      {title}
    </h2>
    {subtitle && (
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1.5 leading-relaxed">
        {subtitle}
      </p>
    )}
  </div>

  <!-- Category Tabs -->
  <div class="flex items-center justify-center gap-2 mb-6 p-1.5 rounded-2xl bg-slate-100 dark:bg-slate-800/80 max-w-md mx-auto">
    {categories.map(cat => (
      <button
        type="button"
        data-cat-btn={cat.id}
        class={`builder-tab-btn flex-1 py-2 px-3 rounded-xl text-xs sm:text-sm font-bold transition-all flex items-center justify-center gap-1.5 ${cat.id === initialCategory ? 'bg-white dark:bg-slate-900 text-blue-600 dark:text-blue-400 shadow-sm' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'}`}
      >
        <span>{cat.icon}</span>
        <span>{cat.label}</span>
      </button>
    ))}
  </div>

  <!-- Brand Quick Filter Row -->
  <div class="flex items-center justify-center gap-1.5 mb-6 flex-wrap brand-filter-container">
    <span class="text-xs font-bold text-slate-400 ml-2">تصفية حسب الشركة:</span>
    <button
      type="button"
      data-brand-filter="all"
      class="brand-pill-btn active px-3 py-1 rounded-lg text-xs font-bold border border-blue-500 bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-300 transition-colors"
    >
      الكل
    </button>
    <!-- Brand pills dynamically populated by client script -->
    <div class="dynamic-brand-pills inline-flex items-center gap-1.5 flex-wrap"></div>
  </div>

  <!-- Selectors Grid (Item 1 vs Item 2) -->
  <div class="grid grid-cols-1 lg:grid-cols-11 gap-4 items-center max-w-4xl mx-auto">
    
    <!-- Item 1 Dropdown -->
    <div class="lg:col-span-5 relative">
      <label class="block text-xs font-extrabold text-slate-700 dark:text-slate-300 mb-2 flex items-center justify-between">
        <span class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-blue-500 inline-block"></span>
          <span>القطعة الأولى (الطرف الأول):</span>
        </span>
        <span class="text-[11px] font-normal text-slate-400 brand-tag-a"></span>
      </label>
      <div class="relative">
        <select
          class="selector-item-a w-full py-3.5 pr-4 pl-10 rounded-2xl border-2 border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white font-bold text-sm focus:outline-none focus:border-blue-500 focus:bg-white dark:focus:bg-slate-900 transition-colors cursor-pointer appearance-none shadow-sm"
        >
          <option value="" disabled selected>اختر القطعة الأولى...</option>
        </select>
        <span class="absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-xs">
          ▼
        </span>
      </div>
    </div>

    <!-- Swap / VS Badge -->
    <div class="lg:col-span-1 flex items-center justify-center py-2 lg:py-0">
      <button
        type="button"
        class="swap-btn w-11 h-11 rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-100 dark:bg-slate-800 hover:bg-blue-50 hover:border-blue-500 dark:hover:bg-blue-950/50 text-slate-700 dark:text-slate-300 hover:text-blue-600 transition-all flex items-center justify-center font-black text-sm shadow-sm group"
        title="تبديل موقع القطعتين"
      >
        <span class="group-hover:rotate-180 transition-transform duration-300">⇄</span>
      </button>
    </div>

    <!-- Item 2 Dropdown -->
    <div class="lg:col-span-5 relative">
      <label class="block text-xs font-extrabold text-slate-700 dark:text-slate-300 mb-2 flex items-center justify-between">
        <span class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-indigo-500 inline-block"></span>
          <span>القطعة الثانية (الطرف المنافس):</span>
        </span>
        <span class="text-[11px] font-normal text-slate-400 brand-tag-b"></span>
      </label>
      <div class="relative">
        <select
          class="selector-item-b w-full py-3.5 pr-4 pl-10 rounded-2xl border-2 border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white font-bold text-sm focus:outline-none focus:border-indigo-500 focus:bg-white dark:focus:bg-slate-900 transition-colors cursor-pointer appearance-none shadow-sm"
        >
          <option value="" disabled selected>اختر القطعة الثانية...</option>
        </select>
        <span class="absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-xs">
          ▼
        </span>
      </div>
    </div>

  </div>

  <!-- Action Bar & Validation Feedback -->
  <div class="mt-6 pt-5 border-t border-slate-100 dark:border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 max-w-4xl mx-auto">
    <div class="feedback-msg text-xs font-semibold text-slate-500 dark:text-slate-400 flex items-center gap-1.5">
      <span class="status-icon">💡</span>
      <span class="status-text">اختر قطعتين مختلفتين للبدء في المقارنة التفصيلية.</span>
    </div>

    <button
      type="button"
      class="compare-now-btn w-full sm:w-auto px-8 py-3.5 rounded-2xl bg-gradient-to-l from-blue-600 via-indigo-600 to-blue-700 hover:from-blue-700 hover:to-indigo-700 text-white font-black text-sm shadow-lg shadow-blue-500/25 hover:shadow-blue-500/40 hover:scale-[1.02] active:scale-[0.98] transition-all disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:scale-100 flex items-center justify-center gap-2"
      disabled
    >
      <span>قارن الآن بالأرقام</span>
      <span>⚡</span>
    </button>
  </div>
</div>

<script is:inline define:vars={{ instanceId }}>
  (function () {
    const root = document.getElementById(instanceId);
    if (!root) return;

    const catalog = JSON.parse(root.getAttribute('data-catalog') || '{}');
    const pairMap = JSON.parse(root.getAttribute('data-pair-map') || '{}');
    let currentCategory = root.getAttribute('data-active-cat') || 'gpu';
    let initialA = root.getAttribute('data-initial-a') || '';
    let initialB = root.getAttribute('data-initial-b') || '';

    const tabBtns = root.querySelectorAll('.builder-tab-btn');
    const selectA = root.querySelector('.selector-item-a');
    const selectB = root.querySelector('.selector-item-b');
    const swapBtn = root.querySelector('.swap-btn');
    const compareBtn = root.querySelector('.compare-now-btn');
    const feedbackIcon = root.querySelector('.status-icon');
    const feedbackText = root.querySelector('.status-text');
    const brandPillsContainer = root.querySelector('.dynamic-brand-pills');
    const brandTagA = root.querySelector('.brand-tag-a');
    const brandTagB = root.querySelector('.brand-tag-b');

    let currentBrandFilter = 'all';

    function getItemsForCurrentCategory(filterBrand = 'all') {
      const catData = catalog[currentCategory] || {};
      const items = [];
      Object.keys(catData).forEach(brand => {
        if (filterBrand === 'all' || brand.toLowerCase() === filterBrand.toLowerCase()) {
          items.push(...catData[brand]);
        }
      });
      return items;
    }

    function renderBrandPills() {
      if (!brandPillsContainer) return;
      brandPillsContainer.innerHTML = '';
      const catData = catalog[currentCategory] || {};
      const brands = Object.keys(catData);

      brands.forEach(brand => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.setAttribute('data-brand-filter', brand);
        btn.className = `brand-pill-btn px-3 py-1 rounded-lg text-xs font-bold border transition-colors ${currentBrandFilter.toLowerCase() === brand.toLowerCase() ? 'border-blue-500 bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-300' : 'border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'}`;
        btn.textContent = brand;
        btn.addEventListener('click', () => {
          setBrandFilter(brand);
        });
        brandPillsContainer.appendChild(btn);
      });

      // Update "all" button state
      const allBtn = root.querySelector('[data-brand-filter="all"]');
      if (allBtn) {
        if (currentBrandFilter === 'all') {
          allBtn.className = 'brand-pill-btn active px-3 py-1 rounded-lg text-xs font-bold border border-blue-500 bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-300 transition-colors';
        } else {
          allBtn.className = 'brand-pill-btn px-3 py-1 rounded-lg text-xs font-bold border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors';
        }
      }
    }

    function setBrandFilter(brand) {
      currentBrandFilter = brand;
      renderBrandPills();
      populateDropdowns();
    }

    const allBtn = root.querySelector('[data-brand-filter="all"]');
    if (allBtn) {
      allBtn.addEventListener('click', () => setBrandFilter('all'));
    }

    function populateDropdowns() {
      const valA = selectA.value;
      const valB = selectB.value;

      const catData = catalog[currentCategory] || {};

      function buildOptions(selectElement, otherValue, selectedValue) {
        selectElement.innerHTML = '';
        const placeholder = document.createElement('option');
        placeholder.value = '';
        placeholder.disabled = true;
        placeholder.selected = !selectedValue;
        placeholder.textContent = selectElement === selectA ? 'اختر القطعة الأولى...' : 'اختر القطعة الثانية...';
        selectElement.appendChild(placeholder);

        Object.keys(catData).forEach(brand => {
          if (currentBrandFilter !== 'all' && brand.toLowerCase() !== currentBrandFilter.toLowerCase()) {
            return;
          }

          const optgroup = document.createElement('optgroup');
          optgroup.label = `─── ${brand} ───`;

          catData[brand].forEach(item => {
            const opt = document.createElement('option');
            opt.value = item.id;
            opt.textContent = item.name;
            if (item.id === otherValue) {
              opt.disabled = true;
              opt.textContent += ' (مختارة بالفعل)';
            }
            if (item.id === selectedValue) {
              opt.selected = true;
            }
            optgroup.appendChild(opt);
          });

          if (optgroup.children.length > 0) {
            selectElement.appendChild(optgroup);
          }
        });
      }

      buildOptions(selectA, valB, valA || initialA);
      buildOptions(selectB, selectA.value, valB || initialB);

      // Consume initial values once
      initialA = '';
      initialB = '';

      updateValidation();
    }

    function updateValidation() {
      const idA = selectA.value;
      const idB = selectB.value;

      // Update brand tags
      if (idA) {
        const itemA = getItemById(idA);
        if (brandTagA && itemA) brandTagA.textContent = itemA.brand;
      } else {
        if (brandTagA) brandTagA.textContent = '';
      }

      if (idB) {
        const itemB = getItemById(idB);
        if (brandTagB && itemB) brandTagB.textContent = itemB.brand;
      } else {
        if (brandTagB) brandTagB.textContent = '';
      }

      if (!idA || !idB) {
        compareBtn.disabled = true;
        feedbackIcon.textContent = '💡';
        feedbackText.textContent = !idA && !idB
          ? 'اختر قطعتين مختلفتين للبدء في المقارنة التفصيلية.'
          : (!idA ? 'يرجى اختيار القطعة الأولى.' : 'يرجى اختيار القطعة الثانية للمقارنة.');
        return;
      }

      if (idA === idB) {
        compareBtn.disabled = true;
        feedbackIcon.textContent = '⚠️';
        feedbackText.textContent = 'لا يمكنك مقارنة القطعة بنفسها، يرجى اختيار قطعتين مختلفتين.';
        return;
      }

      // Check bidirectional slug resolution
      const matchedSlug = pairMap[`${idA}:${idB}`] || pairMap[`${idB}:${idA}`];
      if (matchedSlug) {
        compareBtn.disabled = false;
        feedbackIcon.textContent = '✅';
        feedbackText.textContent = 'المقارنة جاهزة ومدعومة بالكامل! اضغط على زر المقارنة.';
      } else {
        compareBtn.disabled = true;
        feedbackIcon.textContent = '🔍';
        feedbackText.textContent = 'المقارنة المحددة قيد الإعداد قريباً.';
      }
    }

    function getItemById(id) {
      const catData = catalog[currentCategory] || {};
      for (const brand of Object.keys(catData)) {
        const found = catData[brand].find(i => i.id === id);
        if (found) return found;
      }
      return null;
    }

    // Category Tabs Switching
    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-cat-btn');
        if (cat === currentCategory) return;
        currentCategory = cat;

        tabBtns.forEach(b => {
          if (b === btn) {
            b.className = 'builder-tab-btn flex-1 py-2 px-3 rounded-xl text-xs sm:text-sm font-bold transition-all flex items-center justify-center gap-1.5 bg-white dark:bg-slate-900 text-blue-600 dark:text-blue-400 shadow-sm';
          } else {
            b.className = 'builder-tab-btn flex-1 py-2 px-3 rounded-xl text-xs sm:text-sm font-bold transition-all flex items-center justify-center gap-1.5 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white';
          }
        });

        currentBrandFilter = 'all';
        renderBrandPills();
        selectA.value = '';
        selectB.value = '';
        populateDropdowns();
      });
    });

    // Dropdown change events
    selectA.addEventListener('change', () => {
      // Re-populate B to disable newly chosen A
      const valB = selectB.value;
      populateDropdowns();
      if (valB && valB !== selectA.value) {
        selectB.value = valB;
      }
      updateValidation();
    });

    selectB.addEventListener('change', () => {
      updateValidation();
    });

    // Swap button
    if (swapBtn) {
      swapBtn.addEventListener('click', () => {
        const valA = selectA.value;
        const valB = selectB.value;
        if (!valA && !valB) return;
        selectA.value = valB;
        populateDropdowns();
        selectA.value = valB;
        selectB.value = valA;
        updateValidation();
      });
    }

    // Compare Now button action with bidirectional slug resolution
    compareBtn.addEventListener('click', () => {
      const idA = selectA.value;
      const idB = selectB.value;
      if (!idA || !idB || idA === idB) return;

      const matchedSlug = pairMap[`${idA}:${idB}`] || pairMap[`${idB}:${idA}`];
      if (matchedSlug) {
        window.location.href = `/compare/${matchedSlug}`;
      }
    });

    // Initial setup
    renderBrandPills();
    populateDropdowns();
  })();
</script>
