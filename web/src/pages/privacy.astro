---
import BaseLayout from '../layouts/BaseLayout.astro';

const privacySchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "سياسة الخصوصية | مقارنات تك",
  "url": "https://mokaranat-tech.pages.dev/privacy",
  "description": "سياسة الخصوصية الرسمية لمنصة مقارنات تك، توضح كيفية إدارة البيانات وملفات تعريف الارتباط وشبكات الإعلانات التابعة لجهة خارجية مثل Google AdSense وروابط الإحالة المعتمدة.",
  "inLanguage": "ar"
};
---

<BaseLayout
  title="سياسة الخصوصية | مقارنات تك"
  description="سياسة الخصوصية الرسمية لمنصة مقارنات تك، متوافقة مع إرشادات Google AdSense واللائحة العامة لحماية البيانات (GDPR) واستخدام ملفات تعريف الارتباط والشركاء المعتمدين."
  canonicalUrl="https://mokaranat-tech.pages.dev/privacy"
  schema={privacySchema}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Breadcrumbs -->
    <nav aria-label="مسار التنقل" class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-8">
      <a href="/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">الرئيسية</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200 font-medium">سياسة الخصوصية</span>
    </nav>

    <!-- Header Section -->
    <header class="mb-12 border-b border-slate-200 dark:border-slate-800 pb-8">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-blue-400 text-xs font-bold mb-4">
        <span>🔒</span>
        <span>الشفافية وحماية البيانات</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight mb-4">
        سياسة الخصوصية وملفات تعريف الارتباط
      </h1>
      <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed max-w-3xl">
        تلتزم منصة <strong>مقارنات تك (mokaranat-tech.pages.dev)</strong> بأعلى معايير حماية خصوصية زوارها وبياناتهم الشخصية. توضح هذه الوثيقة طبيعة المعلومات التي نجمعها، وكيفية استخدامها، وحقوقك القانونية، وشفافية تعاملنا مع شبكات الإعلانات الرقمية وشركاء المتاجر المعتمدين.
      </p>
      <div class="mt-4 flex flex-wrap items-center gap-4 text-xs text-slate-500 dark:text-slate-400">
        <span>📅 تاريخ آخر تحديث: 21 أكتوبر 2026</span>
        <span>•</span>
        <span>متوافقة مع إرشادات Google AdSense و GDPR</span>
      </div>
    </header>

    <!-- Main Content -->
    <article class="prose prose-slate dark:prose-invert max-w-none space-y-10 text-slate-700 dark:text-slate-300 text-sm leading-relaxed">
      
      <!-- 1. جمع البيانات وسجلات الخوادم -->
      <section class="bg-white dark:bg-slate-900 rounded-2xl p-6 sm:p-8 border border-slate-200 dark:border-slate-800 shadow-sm">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
          <span class="text-blue-600 dark:text-blue-400">1.</span>
          <span>المعلومات التي نقوم بجمعها وسجلات الخوادم (Log Files)</span>
        </h2>
        <p class="mb-3">
          مثل معظم مواقع الويب المستضافة على شبكات سحابية عالمية (Cloudflare Pages)، تتبع منصة <strong>مقارنات تك</strong> إجراءات قياسية في استخدام ملفات السجل (Log Files). تتضمن هذه البيانات المجمعة آلياً:
        </p>
        <ul class="list-disc list-inside space-y-2 mr-2 text-slate-600 dark:text-slate-400">
          <li>عناوين بروتوكول الإنترنت (IP Addresses) مجهولة المصدر لأغراض الحماية ومكافحة الهجمات السيبرانية.</li>
          <li>نوع المتصفح وإصداره (User-Agent) لضمان توافق العرض البرمجي السليم.</li>
          <li>مزود خدمة الإنترنت (ISP)، ونظام التشغيل المستخدم (Windows, macOS, Android, iOS).</li>
          <li>الطابع الزمني وتاريخ الزيارة، والصفحات المرجعية التي دخلت منها وصفحات الخروج.</li>
          <li>عدد النقرات الإجمالية لتحليل الاتجاهات الشائعة وإدارة الموقع وقياس سرعة استجابة الخوادم.</li>
        </ul>
        <p class="mt-4 text-xs bg-slate-50 dark:bg-slate-800/60 p-3.5 rounded-xl border border-slate-200/60 dark:border-slate-700/60">
          💡 <strong>تأكيد:</strong> هذه المعلومات لا ترتبط بأي شكل من الأشكال بأي بيانات تحدد هويتك الشخصية بالاسم أو البريد الإلكتروني، وتُستخدم حصراً للتحليل الإحصائي وتأمين البنية التحتية.
        </p>
      </section>

      <!-- 2. ملفات تعريف الارتباط وإعلانات Google AdSense -->
      <section class="bg-white dark:bg-slate-900 rounded-2xl p-6 sm:p-8 border border-slate-200 dark:border-slate-800 shadow-sm">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
          <span class="text-blue-600 dark:text-blue-400">2.</span>
          <span>ملفات تعريف الارتباط (Cookies) وشبكة Google AdSense</span>
        </h2>
        <p class="mb-3">
          نستخدم ملفات تعريف الارتباط لتحسين تجربة المستخدم، وحفظ التفضيلات المحلية (مثل الوضع الليلي أو النهاري)، وتقديم إعلانات موثوقة تلائم اهتمامات الزائر التقنية:
        </p>
        <div class="space-y-4 mr-2">
          <div class="border-r-4 border-blue-500 pr-4 py-1">
            <h3 class="font-bold text-slate-900 dark:text-white text-base mb-1">ملف تعريف الارتباط DoubleClick DART من Google:</h3>
            <p class="text-slate-600 dark:text-slate-400">
              تستخدم شركة Google بصفتها مورداً لطرف ثالث ملفات تعريف الارتباط لخدمة الإعلانات على موقعنا. يتيح استخدام Google لملف تعريف الارتباط DART عرض الإعلانات للمستخدمين بناءً على زيارتهم لموقع <strong>مقارنات تك</strong> ومواقع أخرى على شبكة الإنترنت.
            </p>
          </div>
          <div class="border-r-4 border-indigo-500 pr-4 py-1">
            <h3 class="font-bold text-slate-900 dark:text-white text-base mb-1">إلغاء الاشتراك في الإعلانات المخصصة:</h3>
            <p class="text-slate-600 dark:text-slate-400">
              يمكن للزوار اختيار تعطيل استخدام ملف تعريف الارتباط DART عبر زيارة <a href="https://policies.google.com/technologies/ads" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 underline font-medium">سياسة خصوصية إعلانات Google وشبكة المحتوى</a>. كما يمكنك إدارة خيارات التفضيلات الإعلانية العامة عبر موقع <a href="https://www.aboutads.info/choices/" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 underline font-medium">AboutAds.info</a> أو <a href="https://youronlinechoices.eu/" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 underline font-medium">Your Online Choices</a> لمستخدمي الاتحاد الأوروبي.
            </p>
          </div>
        </div>
      </section>

      <!-- 3. شبكات الإعلانات الخارجية والشركاء التابعين -->
      <section class="bg-white dark:bg-slate-900 rounded-2xl p-6 sm:p-8 border border-slate-200 dark:border-slate-800 shadow-sm">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
          <span class="text-blue-600 dark:text-blue-400">3.</span>
          <span>شبكات الإعلانات وروابط المتاجر الشريكة (Affiliate Disclosure)</span>
        </h2>
        <p class="mb-3">
          قد تستخدم خوادم الإعلانات التابعة لجهات خارجية أو شبكات الإعلانات تقنيات مثل ملفات تعريف الارتباط أو جافا سكريبت أو إشارات الويب (Web Beacons) في إعلاناتها وروابطها التي تظهر على منصتنا، وتُرسل مباشرة إلى متصفح المستخدمين، متلقية عنوان IP الخاص بك تلقائياً عند حدوث ذلك.
        </p>
        <p class="mb-3">
          <strong>روابط الإحالة والمتاجر المعتمدة:</strong>
          تتضمن منصتنا روابط إحالة تسويقية إلى متاجر إلكترونية رسمية ومعتمدة حصراً، وهي:
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 my-4">
          <div class="bg-slate-50 dark:bg-slate-800/80 p-3 rounded-xl text-center border border-slate-200 dark:border-slate-700">
            <span class="block font-bold text-slate-900 dark:text-white">متجر نون (Noon)</span>
            <span class="text-[11px] text-slate-500">الشرق الأوسط</span>
          </div>
          <div class="bg-slate-50 dark:bg-slate-800/80 p-3 rounded-xl text-center border border-slate-200 dark:border-slate-700">
            <span class="block font-bold text-slate-900 dark:text-white">نيو إيج (Newegg)</span>
            <span class="text-[11px] text-slate-500">عتاد الحواسيب عالمياً</span>
          </div>
          <div class="bg-slate-50 dark:bg-slate-800/80 p-3 rounded-xl text-center border border-slate-200 dark:border-slate-700">
            <span class="block font-bold text-slate-900 dark:text-white">علي إكسبريس (AliExpress)</span>
            <span class="text-[11px] text-slate-500">شحن مباشر عالمي</span>
          </div>
          <div class="bg-slate-50 dark:bg-slate-800/80 p-3 rounded-xl text-center border border-slate-200 dark:border-slate-700">
            <span class="block font-bold text-slate-900 dark:text-white">جوميا (Jumia)</span>
            <span class="text-[11px] text-slate-500">شمال أفريقيا</span>
          </div>
        </div>
        <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
          نحيطكم علماً بأن <strong>مقارنات تك</strong> لا تملك حق الوصول أو التحكم في ملفات تعريف الارتباط هذه التي يستخدمها معلنون أو متاجر خارجية، وتخضع معاملاتك في تلك المتاجر لسياسات الخصوصية وشروط الاستخدام الخاصة بكل متجر على حدة.
        </p>
      </section>

      <!-- 4. حقوق حماية البيانات بموجب اللائحة العامة (GDPR) وقوانين الخصوصية -->
      <section class="bg-white dark:bg-slate-900 rounded-2xl p-6 sm:p-8 border border-slate-200 dark:border-slate-800 shadow-sm">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
          <span class="text-blue-600 dark:text-blue-400">4.</span>
          <span>حقوقك في حماية البيانات (GDPR & International Privacy Rights)</span>
        </h2>
        <p class="mb-3">
          نرغب في التأكد من أنك على دراية تامة بجميع حقوق حماية البيانات الخاصة بك. يحق لكل مستخدم التمتع بالحقوق التالية:
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
          <div class="p-3.5 bg-slate-50 dark:bg-slate-800/50 rounded-xl border border-slate-200/80 dark:border-slate-700/80">
            <strong class="text-slate-900 dark:text-white block mb-1">حق الوصول (Right of Access):</strong>
            يحق لك طلب نسخ من أي بيانات شخصية نحتفظ بها عنك (مثل رسائل التواصل المباشرة).
          </div>
          <div class="p-3.5 bg-slate-50 dark:bg-slate-800/50 rounded-xl border border-slate-200/80 dark:border-slate-700/80">
            <strong class="text-slate-900 dark:text-white block mb-1">حق التصحيح (Right to Rectification):</strong>
            يحق لك طلب تصحيح أي معلومات غير دقيقة أو استكمال البيانات الناقصة.
          </div>
          <div class="p-3.5 bg-slate-50 dark:bg-slate-800/50 rounded-xl border border-slate-200/80 dark:border-slate-700/80">
            <strong class="text-slate-900 dark:text-white block mb-1">حق الحذف والنسيان (Right to Erasure):</strong>
            يحق لك طلب مسح بيانات التواصل الخاصة بك في ظل ظروف معينة وفق القانون.
          </div>
          <div class="p-3.5 bg-slate-50 dark:bg-slate-800/50 rounded-xl border border-slate-200/80 dark:border-slate-700/80">
            <strong class="text-slate-900 dark:text-white block mb-1">حق تقييد المعالجة (Restriction of Processing):</strong>
            يحق لك الاعتراض على معالجة بياناتك أو طلب تقييد استخدامها الإحصائي.
          </div>
        </div>
      </section>

      <!-- 5. خصوصية الأطفال -->
      <section class="bg-white dark:bg-slate-900 rounded-2xl p-6 sm:p-8 border border-slate-200 dark:border-slate-800 shadow-sm">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
          <span class="text-blue-600 dark:text-blue-400">5.</span>
          <span>حماية خصوصية الأطفال (COPPA Compliance)</span>
        </h2>
        <p class="leading-relaxed">
          تعد حماية خصوصية الأطفال أثناء استخدام الإنترنت جزءاً أساسياً من مبادئنا. نحن نشجع أولياء الأمور والأوصياء على مراقبة ومتابعة وتوجيه نشاط أطفالهم عبر الإنترنت. إن منصة <strong>مقارنات تك</strong> لا تجمع عمداً أي معلومات تعريف شخصية من الأطفال دون سن 13 عاماً. إذا كنت تعتقد أن طفلك قد قدم هذا النوع من المعلومات على موقعنا عبر نموذج التواصل، فنحن نحثك بشدة على الاتصال بنا فوراً وسنبذل قصارى جهدنا لإزالة هذه المعلومات على الفور من سجلاتنا.
        </p>
      </section>

      <!-- 6. أمان البيانات وكيفية التواصل -->
      <section class="bg-gradient-to-br from-blue-50/70 to-indigo-50/50 dark:from-slate-900 dark:to-blue-950/40 rounded-2xl p-6 sm:p-8 border border-blue-200/80 dark:border-blue-900/40">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-3 flex items-center gap-2">
          <span>📬</span>
          <span>الاستفسارات والتواصل مع مسؤول الخصوصية</span>
        </h2>
        <p class="mb-4 text-slate-600 dark:text-slate-300">
          إذا كانت لديك أي أسئلة أو استفسارات إضافية حول سياسة الخصوصية الخاصة بنا أو كيفية تعاملنا مع البيانات، فلا تتردد في مراسلتنا مباشرة.
        </p>
        <div class="flex flex-wrap items-center gap-4">
          <a
            href="/contact"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs transition-colors shadow-sm"
          >
            <span>✉️</span>
            <span>الانتقال إلى صفحة اتصل بنا</span>
          </a>
          <span class="text-xs text-slate-500 dark:text-slate-400">
            أو عبر البريد الرسمي: privacy@mokaranat-tech.com
          </span>
        </div>
      </section>

    </article>
  </div>
</BaseLayout>
