---
import BaseLayout from '../layouts/BaseLayout.astro';

const termsSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "شروط الاستخدام وإخلاء المسؤولية | مقارنات تك",
  "url": "https://mokaranat-tech.pages.dev/terms",
  "description": "شروط وأحكام استخدام منصة مقارنات تك، متضمنة إخلاء المسؤولية عن نتائج الأداء المعيارية واختبارات الألعاب، حقوق الملكية الفكرية، وضوابط الروابط الخارجية.",
  "inLanguage": "ar"
};
---

<BaseLayout
  title="شروط الاستخدام وإخلاء المسؤولية | مقارنات تك"
  description="اتفاقية شروط الاستخدام الرسمية لمنصة مقارنات تك، تتضمن إخلاء المسؤولية الفنية عن مؤشرات الأداء ومعدلات الإطارات، حقوق الملكية، وتنظيم روابط المتاجر المعتمدة."
  canonicalUrl="https://mokaranat-tech.pages.dev/terms"
  schema={termsSchema}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Breadcrumbs -->
    <nav aria-label="مسار التنقل" class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-8">
      <a href="/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">الرئيسية</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200 font-medium">شروط الاستخدام</span>
    </nav>

    <!-- Header Section -->
    <header class="mb-12 border-b border-slate-200 dark:border-slate-800 pb-8">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-indigo-50 dark:bg-indigo-950/60 text-indigo-700 dark:text-indigo-400 text-xs font-bold mb-4">
        <span>📜</span>
        <span>الاتفاقية القانونية وحقوق الاستخدام</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight mb-4">
        شروط الاستخدام وإخلاء المسؤولية الفنية
      </h1>
      <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed max-w-3xl">
        أهلاً بك في <strong>مقارنات تك (mokaranat-tech.pages.dev)</strong>. تحكم هذه الوثيقة استخدامك لكافة صفحات المنصة، أدوات المقارنة التفاعلية، ومحركات الحساب الهندسية. يشكل تصفحك للموقع أو اعتمادك على تحليلاته موافقة صريحة وكاملة على هذه الشروط.
      </p>
      <div class="mt-4 flex flex-wrap items-center gap-4 text-xs text-slate-500 dark:text-slate-400">
        <span>📅 تاريخ النفاذ والتحديث: 21 أكتوبر 2026</span>
        <span>•</span>
        <span>مرجعية قانونية للمحتوى الرقمي وحماية المستهلك</span>
      </div>
    </header>

    <!-- Main Content -->
    <article class="prose prose-slate dark:prose-invert max-w-none space-y-10 text-slate-700 dark:text-slate-300 text-sm leading-relaxed">
      
      <!-- 1. إخلاء مسؤولية نتائج الأداء والمعايير -->
      <section class="bg-white dark:bg-slate-900 rounded-2xl p-6 sm:p-8 border border-slate-200 dark:border-slate-800 shadow-sm">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
          <span class="text-indigo-600 dark:text-indigo-400">1.</span>
          <span>إخلاء مسؤولية نتائج الأداء ومعدلات الإطارات (Benchmark Disclaimer)</span>
        </h2>
        <p class="mb-3">
          تحرص منصة <strong>مقارنات تك</strong> على توفير أقصى درجات الدقة الهندسية في مقارنات العتاد، ومع ذلك يجب على المستخدم إدراك الحقائق التقنية التالية:
        </p>
        <ul class="list-disc list-inside space-y-2 mr-2 text-slate-600 dark:text-slate-400">
          <li><strong>معدلات الإطارات التقديرية (Estimated Gaming FPS):</strong> الأرقام المعروضة للألعاب عبر مختلف الدقات (1080p, 1440p, 4K) هي نتائج حسابية ومعيارية مبنية على منصات اختبار قياسية متطورة (معالجات فئة عليا لتفادي عنق الزجاجة، 32GB DDR5 عالية السرعة، أحدث التعريفات المستقرة، وإعدادات رسومية فائقة Ultra دون تفعيل تقنيات توليد الإطارات إلا إذا نُص على ذلك صراحة).</li>
          <li><strong>تباين البيئات الفعلية:</strong> قد يختلف الأداء الواقعي على جهازك الشخصي عن الأرقام المعروضة بنسب متفاوتة بناءً على: نوع المعالج المستخدم، سرعات وترددات ذاكرة الوصول العشوائي (RAM)، درجات حرارة الغرفة، جودة التبريد وتدفق الهواء داخل الكيس، إصدار نظام التشغيل، وتحديثات مشغلات البطاقات الرسومية (Graphics Drivers).</li>
          <li><strong>طبيعة النتائج:</strong> تُقدّم هذه البيانات كأداة استرشادية مبنية على المقارنة المعمارية وتحليلات الأداء المتوقعة، ولا تضمن المنصة تحقيق نفس معدل الإطارات الحرفي في كافة المشاهد أو السيناريوهات.</li>
        </ul>
      </section>

      <!-- 2. حدود الاستشارة الفنية وقرارات الشراء -->
      <section class="bg-white dark:bg-slate-900 rounded-2xl p-6 sm:p-8 border border-slate-200 dark:border-slate-800 shadow-sm">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
          <span class="text-indigo-600 dark:text-indigo-400">2.</span>
          <span>حدود الاستشارة التقنية وقرارات الشراء (Purchase Decisions)</span>
        </h2>
        <p class="mb-3">
          يُقدّم محتوى المنصة لأغراض تعليمية، توعوية، وإرشادية عامة لتبسيط مواصفات العتاد المعقدة للجمهور العربي:
        </p>
        <div class="space-y-3 mr-2">
          <p>
            • <strong>المسؤولية الفردية للمشتري:</strong> تقع مسؤولية اتخاذ قرار الشراء النهائي، وملاءمة القطعة لميزانيتك، وتوافق أبعاد الكرت مع صندوق حاسوبك (Case Clearance)، وقدرة مزود الطاقة (PSU Wattage & Connectors) على عاتق المشتري منفرداً.
          </p>
          <p>
            • <strong>انعدام التبعية القانونية:</strong> لا تتحمل منصة <strong>مقارنات تك</strong> أو فريق تحريرها أي مسؤولية قانونية أو مالية مباشرة أو غير مباشرة عن أي خسائر، أضرار مادية، أو قرارات شراء غير موفقة قد يترتب عليها عدم توافق العتاد مع متطلبات المستخدم.
          </p>
        </div>
      </section>

      <!-- 3. أسعار الإطلاق وروابط المتاجر الخارجية -->
      <section class="bg-white dark:bg-slate-900 rounded-2xl p-6 sm:p-8 border border-slate-200 dark:border-slate-800 shadow-sm">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
          <span class="text-indigo-600 dark:text-indigo-400">3.</span>
          <span>أسعار الإطلاق الرسمية وروابط المتاجر المعتمدة (Affiliate & Pricing)</span>
        </h2>
        <p class="mb-3">
          في إطار التزامنا التام بالشفافية والوضوح:
        </p>
        <div class="space-y-3 text-slate-600 dark:text-slate-400 mr-2">
          <p>
            • <strong>سعر الإطلاق الرسمي الاسترشادي (MSRP):</strong> الأسعار بالدولار المعروضة في جداول المقارنة تمثل أسعار الإطلاق الرسمية الموصى بها من الشركات المصنعة (NVIDIA, AMD, Intel, Apple). الأسعار في الأسواق المحلية والمتاجر تخضع لعوامل العرض والطلب، والرسوم الجمركية، والضرائب المحلية وتتغير باستمرار.
          </p>
          <p>
            • <strong>روابط المتاجر المعتمدة:</strong> نوفر روابط بحث وتوجيه إلى متاجر معتمدة وموثوقة (نون، نيو إيج، علي إكسبريس، جوميا). عند الشراء من خلال هذه الروابط قد نحصل على عمولة تسويقية بسيطة تساهم في تغطية تكاليف الخوادم وتطوير المنصة دون أي تكلفة إضافية عليك.
          </p>
          <p>
            • <strong>تنبيه المتاجر المفتوحة:</strong> عند الانتقال إلى أي منصة مفتوحة (مثل علي إكسبريس)، يُنصح دائماً بالتحقق من تقييم البائع وسجل المراجعات الموثقة للتأكد من حالة السلعة والضمان.
          </p>
        </div>
      </section>

      <!-- 4. حقوق الملكية الفكرية والاستخدام العادل -->
      <section class="bg-white dark:bg-slate-900 rounded-2xl p-6 sm:p-8 border border-slate-200 dark:border-slate-800 shadow-sm">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
          <span class="text-indigo-600 dark:text-indigo-400">4.</span>
          <span>حقوق الملكية الفكرية والاستخدام العادل (Intellectual Property)</span>
        </h2>
        <p class="mb-3">
          كافة مكونات الموقع بما يشمل التصاميم البرمجية، الأكواد، محركات التحليل الحسابية، النصوص التحريرية، والرسوم البيانية التوضيحية هي ملك حصري لمنصة <strong>مقارنات تك</strong> ومحمية بموجب قوانين الملكية الفكرية وحق المؤلف الدولية.
        </p>
        <ul class="list-disc list-inside space-y-2 mr-2 text-slate-600 dark:text-slate-400">
          <li>يُحظر تماماً النسخ الآلي (Web Scraping)، أو استنساخ قواعد البيانات أو التحليلات التحريرية وإعادة نشرها في منصات تجارية منافسة دون موافقة خطية صريحة.</li>
          <li>يُسمح بالاقتباس المحدود للأرقام والنتائج للأغراض الصحفية والتعليمية مع ذكر المصدر بوضوح مع رابط تشعبي نشط للمقارنة الأصلية.</li>
          <li>العلامات التجارية المذكورة (مثل GeForce, Radeon, Core, Ryzen, ROG, Legion, MacBook) هي علامات تجارية مسجلة لأصحابها الشرعيين (NVIDIA, AMD, Intel, Apple, ASUS, Lenovo) واستخدامها في الموقع هو لغرض التعيين والتعريف الفني المقارن فقط.</li>
        </ul>
      </section>

      <!-- 5. تعديل الشروط وحل النزاعات -->
      <section class="bg-white dark:bg-slate-900 rounded-2xl p-6 sm:p-8 border border-slate-200 dark:border-slate-800 shadow-sm">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
          <span class="text-indigo-600 dark:text-indigo-400">5.</span>
          <span>تعديل الشروط وحل النزاعات (Amendments & Jurisdiction)</span>
        </h2>
        <p class="leading-relaxed text-slate-600 dark:text-slate-400 mb-4">
          تحتفظ إدارة منصة <strong>مقارنات تك</strong> بالحق الكامل في تعديل أو تحديث هذه الشروط في أي وقت دون إشعار مسبق لضمان مواكبة المعايير التقنية والتنظيمية. يُعتبر استمرارك في استخدام الموقع بعد إجراء أي تعديل بمثابة قبول ضمني للشروط المحدثة.
        </p>
        <div class="p-4 bg-slate-50 dark:bg-slate-800/60 rounded-xl border border-slate-200/80 dark:border-slate-700/80 text-xs">
          ⚖️ تخضع هذه الاتفاقية وتُفسر وفقاً للأعراف واللوائح المعمول بها في التجارة الإلكترونية وحماية المستهلك، وفي حال نشوء أي خلاف يتم السعي لحله ودياً عبر قنوات التواصل الرسمية.
        </div>
      </section>

      <!-- 6. الاستفسارات القانونية -->
      <section class="bg-gradient-to-br from-indigo-50/70 to-blue-50/50 dark:from-slate-900 dark:to-indigo-950/40 rounded-2xl p-6 sm:p-8 border border-indigo-200/80 dark:border-indigo-900/40">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-3 flex items-center gap-2">
          <span>📬</span>
          <span>التواصل بشأن الشروط وحقوق الملكية</span>
        </h2>
        <p class="mb-4 text-slate-600 dark:text-slate-300">
          لأي استفسارات قانونية، طلبات ترخيص محتوى، أو التبليغ عن انتهاك حقوق الملكية الفكرية:
        </p>
        <div class="flex flex-wrap items-center gap-4">
          <a
            href="/contact"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs transition-colors shadow-sm"
          >
            <span>✉️</span>
            <span>نموذج التواصل والاستفسارات</span>
          </a>
          <span class="text-xs text-slate-500 dark:text-slate-400">
            البريد القانوني: legal@mokaranat-tech.com
          </span>
        </div>
      </section>

    </article>
  </div>
</BaseLayout>
