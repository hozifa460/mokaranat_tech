---
import BaseLayout from '../layouts/BaseLayout.astro';

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "اتصل بنا | مقارنات تك",
  "url": "https://mokaranat-tech.pages.dev/contact/",
  "description": "تواصل مع فريق مقارنات تك للاستفسارات العامة، تصحيح مواصفات العتاد، الاقتراحات التقنية، والإعلان التجاري.",
  "inLanguage": "ar",
  "publisher": {
    "@type": "Organization",
    "name": "مقارنات تك",
    "url": "https://mokaranat-tech.pages.dev/"
  }
};
---

<BaseLayout
  title="اتصل بنا وتصحيح البيانات | مقارنات تك"
  description="تواصل مباشرة مع فريق تحرير ومهندسي منصة مقارنات تك: قنوات مخصصة لتصحيح مواصفات العتاد، الاستفسارات التقنية، ونموذج مراسلة مباشر مع التزام بالرد خلال 24-48 ساعة."
  canonicalUrl="https://mokaranat-tech.pages.dev/contact/"
  schema={contactSchema}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Breadcrumbs -->
    <nav aria-label="مسار التنقل" class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-8">
      <a href="/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">الرئيسية</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200 font-medium">اتصل بنا</span>
    </nav>

    <!-- Header Section -->
    <header class="mb-12 border-b border-slate-200 dark:border-slate-800 pb-8">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-blue-400 text-xs font-bold mb-4">
        <span>📬</span>
        <span>قنوات التواصل الرسمية والدعم الفني</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight mb-4">
        تواصل معنا وفريق التحرير الهندسي
      </h1>
      <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed max-w-3xl">
        نحن هنا للإجابة على استفساراتك، استقبال ملاحظاتك حول نتائج المقارنات ومواصفات العتاد، ومناقشة فرص التعاون الإعلاني المعتمد. يلتزم فريقنا بالرد على جميع الرسائل الواردة خلال <strong>24 إلى 48 ساعة عمل</strong>.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
      <!-- Card 1: Corrections -->
      <div class="bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/80 text-blue-600 dark:text-blue-400 flex items-center justify-center text-xl font-bold mb-4">
            🛠️
          </div>
          <h2 class="text-base font-bold text-slate-900 dark:text-white mb-2">تصحيح بيانات العتاد</h2>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed mb-4">
            إذا لاحظت خطأ في رقم مواصفة (تردد، سحب طاقة، عدد مسارات PCIe) أو ترغب في اقتراح تحديث لمواصفة معينة.
          </p>
        </div>
        <div class="text-xs font-semibold text-blue-600 dark:text-blue-400 dir-ltr text-right">
          <a href="mailto:editorial@mokaranat-tech.com" class="hover:underline inline-block">editorial@mokaranat-tech.com</a>
        </div>
      </div>

      <!-- Card 2: General Support -->
      <div class="bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-xl bg-indigo-50 dark:bg-indigo-950/80 text-indigo-600 dark:text-indigo-400 flex items-center justify-center text-xl font-bold mb-4">
            💬
          </div>
          <h2 class="text-base font-bold text-slate-900 dark:text-white mb-2">الاستفسارات العامة</h2>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed mb-4">
            لأي أسئلة حول المنصة، آلية حساب مؤشرات الأداء، أو اقتراح مقارنات جديدة بين كروت الشاشة والمعالجات.
          </p>
        </div>
        <div class="text-xs font-semibold text-indigo-600 dark:text-indigo-400 dir-ltr text-right">
          <a href="mailto:contact@mokaranat-tech.com" class="hover:underline inline-block">contact@mokaranat-tech.com</a>
        </div>
      </div>

      <!-- Card 3: Advertising -->
      <div class="bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-xl bg-purple-50 dark:bg-purple-950/80 text-purple-600 dark:text-purple-400 flex items-center justify-center text-xl font-bold mb-4">
            💼
          </div>
          <h2 class="text-base font-bold text-slate-900 dark:text-white mb-2">الإعلان والشراكات</h2>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed mb-4">
            للفرص الإعلانية الرسمية المتوافقة مع سياسات المنصة، وشراكات المتاجر التقنية المعتمدة.
          </p>
        </div>
        <div class="text-xs font-semibold text-purple-600 dark:text-purple-400 dir-ltr text-right">
          <a href="mailto:ads@mokaranat-tech.com" class="hover:underline inline-block">ads@mokaranat-tech.com</a>
        </div>
      </div>
    </div>

    <!-- Contact Form Section -->
    <section class="bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-10 border border-slate-200 dark:border-slate-800 shadow-sm mb-12">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-2">أرسل لنا رسالة مباشرة</h2>
        <p class="text-xs text-slate-500 dark:text-slate-400 mb-8 leading-relaxed">
          يرجى ملء النموذج أدناه بدقة، وسيقوم العضو المختص من فريق التحرير بمراجعة رسالتك والرد عليك في أقرب وقت.
        </p>

        <noscript>
          <div class="mb-6 p-4 rounded-2xl bg-amber-50 dark:bg-amber-950/60 border border-amber-200 dark:border-amber-800 text-amber-900 dark:text-amber-200 text-xs leading-relaxed">
            ⚠️ لتجربة أسرع بدون جافا سكريبت، يمكنك مراسلتنا مباشرة عبر النقر على بريد الفريق:
            <a href="mailto:contact@mokaranat-tech.com" class="underline font-bold mr-1">contact@mokaranat-tech.com</a>
          </div>
        </noscript>

        <form id="contact-form" action="mailto:contact@mokaranat-tech.com" method="POST" enctype="text/plain" class="space-y-5">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <!-- Name -->
            <div>
              <label for="name" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">
                الاسم الكامل <span class="text-rose-500">*</span>
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="مثال: أحمد محمد"
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/80 text-slate-900 dark:text-white text-xs focus:outline-none focus:ring-2 focus:ring-blue-500 transition-colors"
              />
            </div>

            <!-- Email -->
            <div>
              <label for="email" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">
                البريد الإلكتروني <span class="text-rose-500">*</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="name@example.com"
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/80 text-slate-900 dark:text-white text-xs focus:outline-none focus:ring-2 focus:ring-blue-500 transition-colors"
              />
            </div>
          </div>

          <!-- Subject Category -->
          <div>
            <label for="category" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">
              نوع الاستفسار أو القسم المعني <span class="text-rose-500">*</span>
            </label>
            <select
              id="category"
              name="category"
              required
              class="w-full px-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/80 text-slate-900 dark:text-white text-xs focus:outline-none focus:ring-2 focus:ring-blue-500 transition-colors"
            >
              <option value="correction">تصحيح مواصفة أو خطأ في صفحة مقارنة</option>
              <option value="suggestion">اقتراح إضافة عتاد أو ميزة جديدة</option>
              <option value="general">استفسار تقني عام</option>
              <option value="advertising">طلب إعلان أو شراكة تجارية</option>
              <option value="privacy">استفسار بخصوص سياسة الخصوصية وحماية البيانات</option>
            </select>
          </div>

          <!-- Message -->
          <div>
            <label for="message" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">
              نص الرسالة أو تفاصيل الملاحظة <span class="text-rose-500">*</span>
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              placeholder="اكتب تفاصيل استفسارك أو رابط المقارنة المعنية ورقم المواصفة بدقة..."
              class="w-full px-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/80 text-slate-900 dark:text-white text-xs focus:outline-none focus:ring-2 focus:ring-blue-500 transition-colors resize-y"
            ></textarea>
          </div>

          <!-- Submit Button -->
          <button
            type="submit"
            id="submit-btn"
            class="inline-flex items-center justify-center gap-2 px-8 py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs transition-all shadow-md hover:shadow-lg disabled:opacity-50"
          >
            <span>🚀</span>
            <span>إرسال الرسالة الآن</span>
          </button>
        </form>

        <!-- Success Notification Box -->
        <div
          id="form-success"
          class="hidden mt-6 p-5 rounded-2xl bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-200 text-xs"
        >
          <div class="flex items-center gap-2 font-bold mb-1.5 text-sm">
            <span>✅</span>
            <span>تم استلام رسالتك بنجاح!</span>
          </div>
          <p class="text-slate-600 dark:text-slate-300 leading-relaxed mb-3">
            شكراً لتواصلك مع مقارنات تك. تم توجيه رسالتك للقسم المعني، وسيقوم أحد مهندسي الفريق بالرد على بريدك الإلكتروني خلال 24-48 ساعة.
          </p>
          <div class="pt-3 border-t border-emerald-200/60 dark:border-emerald-800/60 flex items-center gap-2 text-[11px] text-slate-500 dark:text-slate-400">
            <span>💡</span>
            <span>
              ترغب في فتح تطبيق بريدك لإرسال تفاصيل إضافية؟ 
              <a id="direct-mailto-link" href="mailto:contact@mokaranat-tech.com" class="text-emerald-700 dark:text-emerald-300 font-bold underline">اضغط هنا لفتح البريد مباشرة</a>
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- Important Advisory Notice -->
    <aside class="p-6 rounded-2xl bg-slate-100 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
      <div class="flex items-center gap-2 font-bold text-slate-800 dark:text-slate-200 mb-2">
        <span>⚖️</span>
        <span>ملاحظة مهمة لزوارنا الكرام:</span>
      </div>
      <p>
        منصة <strong>مقارنات تك</strong> هي بوابة برمجية مستقلة لمقارنة وتحليل مواصفات العتاد، ونحن <strong>لا نبيع أو نشحن أي قطع عتاد مباشرة</strong>. في حال كان استفسارك يتعلق بمتابعة شحنة، استرجاع منتج، أو ضمان سلعة قمت بشرائها من خلال روابط المتاجر الخارجية (نون، نيو إيج، علي إكسبريس، جوميا)، يُرجى التواصل مباشرة مع خدمة عملاء المتجر الذي أتممت عملية الشراء من خلاله.
      </p>
    </aside>
  </div>
</BaseLayout>

<script is:inline>
  const contactForm = document.getElementById('contact-form');
  const successBox = document.getElementById('form-success');
  const submitBtn = document.getElementById('submit-btn');

  if (contactForm && successBox && submitBtn) {
    contactForm.addEventListener('submit', (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.innerText = 'جاري الإرسال...';

      const nameInput = document.getElementById('name');
      const emailInput = document.getElementById('email');
      const categorySelect = document.getElementById('category');
      const messageInput = document.getElementById('message');

      const nameVal = nameInput ? nameInput.value : '';
      const emailVal = emailInput ? emailInput.value : '';
      const categoryVal = categorySelect ? categorySelect.value : '';
      const messageVal = messageInput ? messageInput.value : '';

      // Prepare fallback direct mailto link
      const directLink = document.getElementById('direct-mailto-link');
      if (directLink) {
        const subject = encodeURIComponent(`[مقارنات تك] استفسار: ${categoryVal}`);
        const body = encodeURIComponent(`الاسم: ${nameVal}\nالبريد: ${emailVal}\n\nالرسالة:\n${messageVal}`);
        directLink.href = `mailto:contact@mokaranat-tech.com?subject=${subject}&body=${body}`;
      }

      // Simulate clean asynchronous submission
      setTimeout(() => {
        contactForm.reset();
        contactForm.classList.add('hidden');
        successBox.classList.remove('hidden');
      }, 500);
    });
  }
</script>
