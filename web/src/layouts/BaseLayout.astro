---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SchemaJsonLd from '../components/SchemaJsonLd.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  schema?: Record<string, any>;
  ogType?: string;
  ogImage?: string;
}

const {
  title,
  description,
  canonicalUrl,
  schema,
  ogType = 'website',
  ogImage = '/og-image.png'
} = Astro.props;

const siteUrl = 'https://mokaranat-tech.pages.dev';
const rawCanonical = canonicalUrl
  ? (canonicalUrl.startsWith('http') ? canonicalUrl : new URL(canonicalUrl, siteUrl).href)
  : (Astro.site ? new URL(Astro.url.pathname, Astro.site).href : new URL(Astro.url.pathname, siteUrl).href);

// Ensure trailing slash consistency with Astro directory format and sitemap
const pageUrl = (rawCanonical.endsWith('/') || /\.[a-z0-9]+$/i.test(rawCanonical))
  ? rawCanonical
  : `${rawCanonical}/`;

const imagePath = ogImage.startsWith('http')
  ? ogImage
  : (ogImage.startsWith('/') ? ogImage : `/${ogImage}`);

const socialImage = imagePath.startsWith('http')
  ? imagePath
  : (Astro.site ? new URL(imagePath, Astro.site).href : new URL(imagePath, siteUrl).href);
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content="ar_SA" />
    <meta property="og:site_name" content="مقارنات تك" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:url" content={pageUrl} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Favicon & Sitemap -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <!-- Inline script to avoid Dark Mode flash (FOUC) -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>

    <!-- Schema.org JSON-LD Structured Data -->
    {schema && <SchemaJsonLd schema={schema} />}
  </head>
  <body class="flex flex-col min-h-screen">
    <!-- Top Affiliate Transparency Notice Bar (FTC & Google SEO Compliant) -->
    <aside aria-label="Affiliate Transparency Disclosure" class="bg-slate-100 dark:bg-slate-800/90 text-slate-600 dark:text-slate-400 text-xs py-1.5 px-4 border-b border-slate-200 dark:border-slate-800 text-center font-medium">
      <div class="max-w-7xl mx-auto flex items-center justify-center gap-2">
        <span>⚖️</span>
        <span>إفصاح الشفافية: قد نحصل على عمولة تسويقية عند الشراء من خلال هذه الروابط دون أي تكلفة إضافية عليك.</span>
      </div>
    </aside>

    <Header />
    
    <main class="flex-grow">
      <slot />
    </main>

    <Footer />
  </body>
</html>
